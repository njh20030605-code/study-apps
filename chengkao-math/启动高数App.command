#!/bin/bash
# ============================================================
# 双击这个文件启动"成考高数 AI 私教"
# 用本地小服务器打开 App，并把学习进度自动备份到 backups/ 文件夹。
# 【重要】以后都用这个启动，别再直接双击 index.html，否则进度对不上。
# 用完直接关掉弹出的黑色终端窗口即可。
# ============================================================
cd "$(dirname "$0")"
echo "正在启动 成考高数 AI 私教 ..."
echo "（学习时请勿关闭本窗口；用完关掉即可。进度会自动备份到 backups/ 文件夹）"
python3 server.py
